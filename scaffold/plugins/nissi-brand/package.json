{
  "name": "nissi-brand",
  "version": "0.1.0",
  "private": true,
  "description": "Nissi 的品牌占位：左栏图标 / 名称 / 配色 / favicon（顶掉 @deepseek-ai/dsh-client-ui-brand-official）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "kernel": true,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
