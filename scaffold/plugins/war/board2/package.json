{
  "name": "nissi-war-board2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "战争模式插件 board2（移植自 DSH 0.1.1 的 war preset）",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "kernel": true,
    "warSource": {
      "dir": "board2",
      "originalName": "hive-board",
      "importedFrom": "<HOME>/.dsh/.agent-presets/war"
    }
  }
}
